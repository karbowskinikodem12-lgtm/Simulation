{
  "name": "road-to-270",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Road to 270 — symulator wyborów prezydenckich w USA (przeglądarka)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
